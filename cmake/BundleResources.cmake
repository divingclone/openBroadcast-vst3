file(MAKE_DIRECTORY "${DESTINATION}/runtime" "${DESTINATION}/licenses")
file(COPY "${ASSETS}/models" "${ASSETS}/licenses" "${ASSETS}/dsp.bin" "${ASSETS}/manifest.json"
     DESTINATION "${DESTINATION}")
if(PLATFORM STREQUAL "Windows")
  file(GLOB libraries "${RUNTIME}/*.dll")
  list(APPEND libraries "${DIRECTML}")
elseif(PLATFORM STREQUAL "Darwin")
  file(GLOB libraries "${RUNTIME}/*.dylib")
else()
  # Linux workers execute in separate processes. Each directory contains one
  # core runtime, its matching provider and its worker; models are shared above.
  file(GLOB obsolete "${DESTINATION}/runtime/*.so*")
  if(obsolete)
    file(REMOVE ${obsolete})
  endif()
  function(copy_linux_runtime source worker name provider sdk)
    set(target "${DESTINATION}/runtime/${name}")
    file(MAKE_DIRECTORY "${target}" "${DESTINATION}/licenses/${name}")
    file(GLOB old_libraries "${target}/*.so*")
    if(old_libraries)
      file(REMOVE ${old_libraries})
    endif()
    # Copy the actual core once, avoiding three flattened SONAME aliases in ZIP.
    file(COPY_FILE "${source}/libonnxruntime.so" "${target}/libonnxruntime.so")
    foreach(library libonnxruntime_providers_shared.so ${provider})
      if(EXISTS "${source}/${library}")
        file(COPY_FILE "${source}/${library}" "${target}/${library}")
      endif()
    endforeach()
    file(COPY "${worker}" DESTINATION "${target}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    foreach(license LICENSE LICENSE.txt ThirdPartyNotices.txt)
      if(EXISTS "${sdk}/${license}")
        file(COPY_FILE "${sdk}/${license}" "${DESTINATION}/licenses/${name}/${license}")
      endif()
    endforeach()
  endfunction()
  copy_linux_runtime("${RUNTIME}" "${CUDA_WORKER}" cuda libonnxruntime_providers_cuda.so "${ORT_SDK}")
  if(AMD_WORKER)
    copy_linux_runtime("${AMD_ORT_SDK}/lib" "${AMD_WORKER}" migraphx libonnxruntime_providers_migraphx.so "${AMD_ORT_SDK}")
  endif()
  return()
endif()
if(NOT libraries)
  message(FATAL_ERROR "No native ONNX Runtime libraries found in ${RUNTIME}")
endif()
# This generated directory belongs to the bundle. Switching a build directory
# between CUDA and MIGraphX must not retain providers from the previous runtime.
file(GLOB previous_libraries "${DESTINATION}/runtime/*.so*" "${DESTINATION}/runtime/*.dylib" "${DESTINATION}/runtime/*.dll")
if(previous_libraries)
  file(REMOVE ${previous_libraries})
endif()
file(COPY ${libraries} DESTINATION "${DESTINATION}/runtime" FOLLOW_SYMLINK_CHAIN)
foreach(license LICENSE LICENSE.txt ThirdPartyNotices.txt)
  if(EXISTS "${ORT_SDK}/${license}")
    file(COPY_FILE "${ORT_SDK}/${license}" "${DESTINATION}/licenses/ONNXRuntime-${license}")
  endif()
endforeach()
